root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.swift]
indent_style = space
indent_size = 4

# shfmt reads its options from these sections; it does not expand braces.
[*.sh]
indent_style = space
indent_size = 4
switch_case_indent = true

[machine-image/container-compose-idle-shutdown]
indent_style = space
indent_size = 4
switch_case_indent = true

[{Makefile,*.mk}]
indent_style = tab
